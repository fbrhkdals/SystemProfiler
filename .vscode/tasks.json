{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "Build SystemProfiler",
            "command": "cl.exe",
            "args": [
                "/Zi",
                "/EHsc",
                "/nologo",
                "/Fe${fileDirname}\\SystemProfiler.exe",
                "${fileDirname}\\*.cpp",
                "/source-charset:utf-8",
                "/execution-charset:utf-8",
                "psapi.lib",
                "user32.lib",
                "gdi32.lib",
                "advapi32.lib",
                "shell32.lib",
                "/link",
                "/MANIFESTUAC:level='requireAdministrator'"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Visual Studio 2022 MSVC를 이용한 빌드"
        }
    ]
}